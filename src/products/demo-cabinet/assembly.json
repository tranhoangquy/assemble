{
  "id": "demo-cabinet-assembly",
  "steps": [
    { "id": "build-shell", "name": "Build Cabinet Shell", "actions": [
      { "type": "focus", "targets": ["cabinet_bottom", "left_side", "right_side", "cabinet_back", "cabinet_top"], "at": 0, "duration": 0.3 },
      { "type": "move", "target": "cabinet_bottom", "from": [0, -40, 0], "to": [0, 3, 0], "at": 0.4, "duration": 1.2 },
      { "type": "move", "target": "left_side", "from": [-130, 90, 0], "to": [-67, 90, 0], "at": 1.1, "duration": 1.3 },
      { "type": "move", "target": "right_side", "from": [130, 90, 0], "to": [67, 90, 0], "at": 1.3, "duration": 1.3 },
      { "type": "move", "target": "cabinet_back", "from": [0, 90, -95], "to": [0, 90, -22], "at": 2.3, "duration": 1.4 },
      { "type": "move", "target": "cabinet_top", "from": [0, 230, 0], "to": [0, 177, 0], "at": 3.1, "duration": 1.2 },
      { "type": "clearFocus", "at": 5.1, "duration": 0.4 }
    ] },
    { "id": "install-shelves", "name": "Install Shelves", "actions": [
      { "type": "focus", "targets": ["shelf_a", "shelf_b"], "related": ["left_side", "right_side"], "at": 0, "duration": 0.3 },
      { "type": "move", "target": "shelf_a", "from": [0, 121, 90], "to": [0, 121, 0], "at": 0.8, "duration": 1.5 },
      { "type": "move", "target": "shelf_b", "from": [0, 62, 90], "to": [0, 62, 0], "at": 2, "duration": 1.5 },
      { "type": "clearFocus", "at": 4.4, "duration": 0.4 }
    ] },
    { "id": "install-doors", "name": "Install Doors", "actions": [
      { "type": "focus", "targets": ["door_left", "door_right", "handle_left", "handle_right"], "related": ["left_side", "right_side"], "at": 0, "duration": 0.3 },
      { "type": "move", "target": "door_left", "from": [31, 0, 100], "to": [31, 0, 0], "at": 0.8, "duration": 1.7 },
      { "type": "move", "target": "door_right", "from": [-31, 0, 100], "to": [-31, 0, 0], "at": 1.3, "duration": 1.7 },
      { "type": "scale", "target": "handle_left", "from": [0.05, 0.05, 0.05], "to": [1, 1, 1], "at": 3, "duration": 0.8 },
      { "type": "scale", "target": "handle_right", "from": [0.05, 0.05, 0.05], "to": [1, 1, 1], "at": 3.3, "duration": 0.8 },
      { "type": "clearFocus", "at": 4.7, "duration": 0.4 }
    ] }
  ]
}
